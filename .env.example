# Copy to .env.local and fill in. Never commit real values.
# Use TEST keys only outside production (Stripe keys must start with sk_test_/pk_test_).

# --- WooCommerce (backend) ---
WOOCOMMERCE_URL=https://test.piece.dk
# WooCommerce → Settings → Advanced → REST API → key with Read/Write permissions,
# belonging to a user who can manage WooCommerce.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Optional: secret used by WooCommerce product webhooks → /api/revalidate
WOOCOMMERCE_WEBHOOK_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (Dashboard → Developers → Webhooks, or `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# --- Storefront ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Identifies this shop on WooCommerce orders and Stripe payments (multishop-ready).
NEXT_PUBLIC_STORE_ID=piece-dk
NEXT_PUBLIC_STORE_NAME=Hverdag
NEXT_PUBLIC_SUPPORT_EMAIL=kundeservice@example.com
