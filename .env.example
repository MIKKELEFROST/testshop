# Copy to .env.local and fill in. Never commit real values.
# Use TEST keys only outside production (Stripe keys must start with sk_test_/pk_test_).

# --- WooCommerce (backend) ---
WOOCOMMERCE_URL=https://test.piece.dk
# WooCommerce → Settings → Advanced → REST API → key with Read/Write permissions,
# belonging to a user who can manage WooCommerce.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Optional: secret used by WooCommerce product webhooks → /api/revalidate
WOOCOMMERCE_WEBHOOK_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (Dashboard → Developers → Webhooks, or `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# Random string (at least 16 characters). Vercel sends it to the daily cron job that captures sent
# orders and releases cancelled ones WordPress could not report (vercel.json). Optional locally.
CRON_SECRET=

# --- Storefront ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# This storefront's store ID: picks its brand (src/config/store.ts) and its webshop in
# WooCommerce (Products → Webshops), and is written to orders and Stripe payments.
NEXT_PUBLIC_STORE_ID=piece-dk
# Optional: overrides the brand's name.
NEXT_PUBLIC_STORE_NAME=
# Optional: customer service e-mail (footer, info pages, Reply-To in order e-mails). Leave it
# empty to use the brand's own address in src/config/store.ts, e.g. hej@halloweenkostumer.dk.
NEXT_PUBLIC_SUPPORT_EMAIL=
