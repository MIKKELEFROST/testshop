{
  "name": "headless-woo-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "WC_INTEGRATION=1 vitest run tests/integration",
    "typecheck": "next typegen && tsc --noEmit",
